#!/bin/sh

export PATH=/bin

# Stay PID 1: toybox poweroff/reboot/halt send SIGUSR2/TERM/USR1 to init.
# exec'ing getty would make getty PID 1 and those signals do nothing.
trap 'sync; poweroff -f' USR2
trap 'sync; reboot -f' TERM
trap 'sync; halt -f' USR1

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /var/run
mount -t devtmpfs -o mode=1777 devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts -o gid=5,mode=0620 /dev/pts
# /dev/shm is always a mount; force mode after mount.
mount -t tmpfs tmpfs /dev/shm
chmod 1777 /dev/shm
mount -t vfat /dev/mmcblk0p1 /boot

dmesg -n 1

# kernel utsname; /etc/hostname alone is not enough for gethostname()
[ -s /etc/hostname ] && hostname -F /etc/hostname

# Prefer kernel usermode helper when built with CONFIG_UEVENT_HELPER.
if [ -w /proc/sys/kernel/hotplug ]; then
	echo /bin/hotplugd > /proc/sys/kernel/hotplug
fi

modprobe hid_apple
modprobe realtek
modprobe rtl8150
modprobe r8152
modprobe cfg80211
modprobe mac80211
modprobe rfkill
modprobe rtl8xxxu

clear
while true; do
	getty 115200 tty0 linux
done
