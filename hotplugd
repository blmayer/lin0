#!/bin/sh
# hotplugd — minimal mdev-style hotplug helper for lin0.
#
#   hotplugd -s     coldplug once
#   hotplugd -d     poll loop (default on boards without UEVENT_HELPER)
#   hotplugd        kernel usermode helper (ACTION/SUBSYSTEM/DEVNAME in env)
#
# Hardcoded rules (numeric gids match etc/group):
#   /dev/input/*  /dev/uinput  → 0:45 (input)  0660
#   /dev/fb*      /dev/dri/*   → 0:44 (video)  0660

export PATH=/bin

# etc/group: video:x:44:  input:x:45:
VIDEO_GID=44
INPUT_GID=45

fix_node() {
	# $1=path  $2=gid
	[ -e "$1" ] || return 0
	[ -c "$1" ] || [ -b "$1" ] || return 0
	chown "0:$2" "$1" || return 0
	chmod 660 "$1" || true
}

apply_all() {
	if [ -d /dev/input ]; then
		chown "0:$INPUT_GID" /dev/input 2>/dev/null || true
		chmod 755 /dev/input 2>/dev/null || true
		for n in /dev/input/*; do
			[ -e "$n" ] || continue
			fix_node "$n" "$INPUT_GID"
		done
	fi
	fix_node /dev/uinput "$INPUT_GID"

	for n in /dev/fb*; do
		[ -e "$n" ] || continue
		fix_node "$n" "$VIDEO_GID"
	done

	if [ -d /dev/dri ]; then
		chown "0:$VIDEO_GID" /dev/dri 2>/dev/null || true
		chmod 755 /dev/dri 2>/dev/null || true
		for n in /dev/dri/*; do
			[ -e "$n" ] || continue
			fix_node "$n" "$VIDEO_GID"
		done
	fi
}

handle_uevent() {
	case "${ACTION:-}" in
	add|change) ;;
	*) return 0 ;;
	esac

	case "${SUBSYSTEM:-}" in
	input|hid)
		[ -n "${DEVNAME:-}" ] && fix_node "/dev/$DEVNAME" "$INPUT_GID"
		apply_all
		;;
	graphics|drm|fb)
		[ -n "${DEVNAME:-}" ] && fix_node "/dev/$DEVNAME" "$VIDEO_GID"
		apply_all
		;;
	esac
}

case "${1:-}" in
-s|--scan)
	apply_all
	exit 0
	;;
-d|--daemon)
	while true; do
		apply_all
		sleep 1
	done
	;;
-h|--help)
	printf '%s\n' \
		'hotplugd -s     coldplug' \
		'hotplugd -d     poll daemon' \
		'hotplugd        kernel helper (env ACTION/SUBSYSTEM/DEVNAME)' \
		'rules: input→gid 45, fb/dri→gid 44 (see /etc/group)'
	exit 0
	;;
esac

if [ -n "${ACTION:-}" ] || [ -n "${SUBSYSTEM:-}" ]; then
	handle_uevent
	exit 0
fi

apply_all
