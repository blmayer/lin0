# lin0 Radxa CM5 + IO — allnoconfig + bootable HDMI/USB/SD set.
# Applied via scripts/gen-radxacm5io-linux-config.sh (allnoconfig → merge → olddefconfig).

# --- SoC / CPU ---
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_HOTPLUG_CPU=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_CRYPTO=y
CONFIG_CRYPTO_AES_ARM64_CE=y
CONFIG_CRYPTO_SHA2_ARM64_CE=y

# --- Boot / device tree (no initrd; extlinux supplies real root=) ---
# CONFIG_BLK_DEV_INITRD is not set
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_OF_OVERLAY=y
# Real root= comes from extlinux (root=LABEL=lin0root); this is only a fallback
# Console: HDMI VT/fbcon only (no serial / earlycon)
CONFIG_CMDLINE="console=tty0 root=LABEL=lin0root rootfstype=ext4 rootwait rw"
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_CMDLINE_FORCE=n
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_DYNAMIC_DEBUG=y

# --- Core for musl/toybox/mksh / IPC ---
CONFIG_MULTIUSER=y
CONFIG_BUG=y
CONFIG_BASE_FULL=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_FHANDLE=y
CONFIG_POSIX_TIMERS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KALLSYMS=y
CONFIG_SYSCTL=y
CONFIG_PROC_SYSCTL=y
# Loadable modules (hid_apple, Realtek PHY/USB eth, …)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
# Userspace modprobe lives at /bin/modprobe (toybox); default /sbin/modprobe is wrong here
CONFIG_MODPROBE_PATH="/bin/modprobe"
# Keep tunnel helpers built-in (avoid the only =m leftovers from olddefconfig)
CONFIG_NET_IP_TUNNEL=y
CONFIG_INET_TUNNEL=y
CONFIG_IPV6_SIT=y

# --- Executable formats (required for /bin/init #!/bin/sh and /bin/sh ELF) ---
# Without these, kernel reports: Failed to execute /bin/init (error -8 / ENOEXEC)
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- Block + partitions (GPT image: p1 FAT LIN0BOOT, p2 ext4 lin0root) ---
# (pseudo-FS listed again under Filesystems section below)
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
# USB mass storage (optional; needs SCSI/SD below)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# --- MMC / SD / eMMC (boot + root on SD/eMMC, not SCSI) ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=16
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_CQHCI=y
CONFIG_PWRSEQ_EMMC=y
CONFIG_PWRSEQ_SIMPLE=y

# --- Filesystems we actually use on the image ---
# root=LABEL=lin0root rootfstype=ext4 (see extlinux / mkimg labels)
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_JBD2=y
CONFIG_FS_MBCACHE=y
CONFIG_FS_IOMAP=y
CONFIG_BUFFER_HEAD=y
CONFIG_FS_POSIX_ACL=y
CONFIG_EXPORTFS=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_DNOTIFY=y
CONFIG_FANOTIFY=y
# CRC / crypto used heavily by ext4 (metadata checksums)
CONFIG_CRC16=y
CONFIG_CRC32=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_CRC32=y
CONFIG_CRYPTO_LIB_CRC32C=y
# FAT boot partition (LABEL=LIN0BOOT) — kernel reads Image/DTB/extlinux only via U-Boot usually,
# but mount /boot from userspace needs these
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_UNICODE=y
# Pseudo / config (init mounts these)
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_CONFIGFS_FS=y
# Not required for lin0 boot, but cheap and common on embedded images
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_EROFS_FS is not set
# CONFIG_FS_ENCRYPTION is not set
# CONFIG_FS_VERITY is not set
# CONFIG_BLK_DEV_INITRD is not set


# --- Character devices / terminals (TTY, VT, PTY, serial, input) ---
# Required for getty, mksh, job control, /dev/null|zero|tty|pts, HDMI fbcon, USB kbd
CONFIG_TTY=y
CONFIG_TTY_PRINTK=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=y
CONFIG_LEGACY_PTY_COUNT=16
CONFIG_LDISC_AUTOLOAD=y
# Virtual terminals (tty0..tty63) — HDMI/fbcon login target
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_CONSOLE_SLEEP=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_HW_CONSOLE=y
# UART hardware only (no kernel serial console — HDMI fbcon is the sole console)
CONFIG_SERIAL_CORE=y
# CONFIG_SERIAL_CORE_CONSOLE is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_DEPRECATED_OPTIONS=y
CONFIG_SERIAL_8250_16550A_VARIANTS=y
# CONFIG_SERIAL_8250_CONSOLE is not set
CONFIG_SERIAL_8250_DMA=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_NR_UARTS=16
CONFIG_SERIAL_8250_RUNTIME_UARTS=16
CONFIG_SERIAL_OF_PLATFORM=y
# CONFIG_SERIAL_EARLYCON is not set
# CONFIG_SERIAL_EARLYCON_SEMIHOST is not set
# Framebuffer console on DRM (tty0 / HDMI only)
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
# Deferred takeover keeps last kernel/bootloader frame until userspace "owns" fb —
# with a minimal init that looks like a frozen screen. Take over immediately.
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
# No boot penguins / logo on framebuffer console
# CONFIG_LOGO is not set

# --- Input + HID keyboards (HID_SUPPORT must precede HID_* for merge_config) ---
CONFIG_HID_SUPPORT=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_USB=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSEDEV_PSAUX=y
CONFIG_INPUT_MOUSEDEV_SCREEN_X=1024
CONFIG_INPUT_MOUSEDEV_SCREEN_Y=768
CONFIG_INPUT_LEDS=y
# LED class required by hid_apple (caps/num lock LEDs)
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_USB_HID=y
CONFIG_USB_HIDDEV=y
# Apple keyboards / Magic Keyboard over USB (module — load with modprobe hid_apple)
CONFIG_HID_APPLE=m
# CONFIG_HID_APPLEIR is not set
# Common USB HID keyboards (hubs / non-Apple brands)
CONFIG_HID_A4TECH=y
CONFIG_HID_BELKIN=y
CONFIG_HID_CHERRY=y
CONFIG_HID_CHICONY=y
CONFIG_HID_CYPRESS=y
CONFIG_HID_EZKEY=y
CONFIG_HID_GYRATION=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_MONTEREY=y
CONFIG_HID_SUNPLUS=y

# Misc char devices often expected by userspace
CONFIG_DEVMEM=y
# CONFIG_DEVKMEM is not set
CONFIG_NULL_TTY=y
CONFIG_HANGCHECK_TIMER=y
# Magic SysRq on VT/HDMI console
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x1

# --- Pinctrl / GPIO ---
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_ROCKCHIP=y

# --- Clocks / resets / power / thermal (aligned with arm64 defconfig + Radxa rockchip_linux_defconfig) ---
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_COMMON_CLK_RK808=y
CONFIG_CLK_RK3588=y
CONFIG_RESET_CONTROLLER=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_ARM_SCPI_CPUFREQ=y
CONFIG_ARM_SCMI_CPUFREQ=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_IIO=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_NVMEM=y
CONFIG_NVMEM_ROCKCHIP_EFUSE=y
CONFIG_NVMEM_ROCKCHIP_OTP=y

# --- I2C + PMIC (RK806/RK8xx on CM5; mainline/Radxa both enable these) ---
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_RK3X=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
CONFIG_REGULATOR_PWM=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_MFD_RK8XX_SPI=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_RK806=y
CONFIG_INPUT_RK805_PWRKEY=y
CONFIG_SPI=y
CONFIG_SPI_ROCKCHIP=y
CONFIG_SPI_ROCKCHIP_SFC=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_RK808=y

# --- DMA ---
CONFIG_DMADEVICES=y
CONFIG_PL330_DMA=y
CONFIG_DW_DMAC=y
CONFIG_DW_DMAC_CORE=y
CONFIG_DW_DMAC_PL330=y

# --- IRQ / timers / firmware ---
CONFIG_GENERIC_IRQ_CHIP=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_SCMI_PROTOCOL=y
CONFIG_ARM_SCPI_PROTOCOL=y

# --- IOMMU + CMA (VOP2 / HDMI DMA; mainline defconfig enables IOMMU/SMMU) ---
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_API=y
CONFIG_IOMMU_IO_PGTABLE_LPAE=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_V3=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_DMA_CMA=y
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=128

# --- HDMI / DRM (RK3588 uses classic DW_HDMI *and* HDMI_QP in mainline defconfig) ---
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_FB=y
# (FB + fbcon already enabled under Character devices; no LOGO)
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_ROCKCHIP_DW_HDMI_QP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_ROCKCHIP_DW_DP=y
CONFIG_ROCKCHIP_CDN_DP=y
CONFIG_ROCKCHIP_ANALOGIX_DP=y
CONFIG_ROCKCHIP_INNO_HDMI=y
CONFIG_ROCKCHIP_LVDS=y
CONFIG_DRM_DW_HDMI=y
CONFIG_DRM_DW_HDMI_AHB_AUD=y
CONFIG_DRM_DW_HDMI_I2S_AUD=y
CONFIG_DRM_DW_HDMI_CEC=y
CONFIG_DRM_DW_HDMI_QP=y
CONFIG_DRM_DW_HDMI_QP_CEC=y
CONFIG_DRM_DW_MIPI_DSI=y
CONFIG_DRM_DISPLAY_CONNECTOR=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_BRIDGE=y
CONFIG_DRM_SIMPLE_BRIDGE=y
CONFIG_HDMI=y
CONFIG_MEDIA_CEC_SUPPORT=y
CONFIG_CEC_CORE=y
CONFIG_CEC_NOTIFIER=y
# Mali-G610 on RK3588S — mainline Panthor (not Panfrost; G610 is Valhall)
CONFIG_DRM_PANTHOR=y
CONFIG_IOMMU_IO_PGTABLE_ARMV7S=y
# PHYs: mainline/Radxa enable eMMC + USB2 + Type-C + HDPTX (HDMI/DP PHY on RK3588)
CONFIG_PHY_ROCKCHIP_EMMC=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_PHY_ROCKCHIP_INNO_HDMI=y
CONFIG_PHY_ROCKCHIP_USBDP=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
CONFIG_PHY_ROCKCHIP_SAMSUNG_HDPTX=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_PHY_ROCKCHIP_SNPS_PCIE3=y
CONFIG_PHY_ROCKCHIP_TYPEC=y
CONFIG_PHY_ROCKCHIP_PCIE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_PWM_SYSFS=y

# --- Ethernet (Radxa/mainline enable stmmac/dwmac; helps confirm board life without serial) ---
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_STMICRO=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_PHYLIB=y
CONFIG_FIXED_PHY=y
# Realtek PHYs as modules: RTL821x / RTL8221 / RTL8226 / RTL8228 (2.5G) family
CONFIG_REALTEK_PHY=m
CONFIG_MOTORCOMM_PHY=y
CONFIG_ROCKCHIP_PHY=y
CONFIG_MDIO_DEVICE=y
CONFIG_MDIO_BUS=y
CONFIG_MDIO_BUS_MUX=y
CONFIG_MDIO_BUS_MUX_GPIO=y
CONFIG_MDIO_BUS_MUX_MMIOREG=y
# USB Realtek ethernet dongles (RTL8150 / RTL8152 / RTL8153 / RTL8156 — similar family)
CONFIG_USB_NET_DRIVERS=y
CONFIG_MII=y
CONFIG_USB_RTL8150=m
CONFIG_USB_RTL8152=m

# --- USB host (re-assert HID so USB+keyboard stay on after USB deps resolve) ---
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_COMMON=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_HIDDEV=y
CONFIG_HID_APPLE=m
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_FUSB302=y

# --- LEDs (class already on for HID_APPLE; add board triggers) ---
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_PWM=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_NETDEV=y

# --- WLAN: Realtek RTL8188EU USB only (mainline rtl8xxxu) ---
# Firmware: /lib/firmware/rtlwifi/rtl8188eufw.bin (installed by post-install)
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_MAC80211=m
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_LEDS=y
CONFIG_RFKILL=m
CONFIG_WLAN=y
# All other Wi‑Fi vendors off
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# Realtek: only rtl8xxxu (8188EU family) — not rtlwifi / rtw88 / rtw89 / rtl818x
CONFIG_WLAN_VENDOR_REALTEK=y
# CONFIG_RTL8180 is not set
# CONFIG_RTL8187 is not set
# CONFIG_RTL_CARDS is not set
# CONFIG_RTL8192CE is not set
# CONFIG_RTL8192SE is not set
# CONFIG_RTL8192DE is not set
# CONFIG_RTL8723AE is not set
# CONFIG_RTL8723BE is not set
# CONFIG_RTL8188EE is not set
# CONFIG_RTL8192EE is not set
# CONFIG_RTL8821AE is not set
# CONFIG_RTL8192CU is not set
# CONFIG_RTL8192DU is not set
# CONFIG_RTW88 is not set
# CONFIG_RTW89 is not set
CONFIG_RTL8XXXU=m
# Extra USB IDs (helps clone 8188EU sticks)
CONFIG_RTL8XXXU_UNTESTED=y
# WPA crypto used by mac80211 (keep built-in so modular wifi just works)
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_GHASH=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_SEQIV=y
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_HASH=y
CONFIG_KEYS=y

# --- Explicitly off (still not full vendor defconfig) ---
# CONFIG_PCI is not set
# CONFIG_SOUND is not set
# CONFIG_BT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_DRM_PANFROST is not set
# CONFIG_VIRTIO is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_FUSE_FS is not set
# CONFIG_EFI is not set
# CONFIG_WATCHDOG is not set
# (SQUASHFS/OVERLAY enabled above in Filesystems — do not disable here)
